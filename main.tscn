[sub_resource type="GDScript" id="GDScript_ycdy4"]
script/source = "extends Area2D


func _on_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"Player\"):
		GlobalState.do_kill()
	elif body.is_in_group(\"Enemy\"):
		body.damage()
"

